from OpenGL.GL import *
from OpenGL.GLUT import *
from OpenGL.GLU import *
import math
import random
import sys

# Global Constants & Variables

W_WIDTH, W_HEIGHT = 1000, 800
GRID_LENGTH = 800
fovY = 120

# Game State
player_pos = [0.0, 0.0, 0.0]
player_vel = [0.0, 0.0, 0.0] # Velocity X, Y, Z
player_angle = 90.0
player_health = 100.0
max_health = 100.0

fear_level = 0.0
max_fear = 100.0
game_level = 1
score = 0
game_over = False
game_win = False
level_text_timer = 0.0

leg_angle = 0.0
is_moving = False

# Entities
ghosts = []
bullets = []
powerups = []

# Input State
keys_pressed = set()

# Camera
camera_mode = 0 # 0: Third, 1: First, 2: Top
camera_pos = [0, 500, 500]
camera_look_at = [0, 0, 0]

# Logic Constants
PLAYER_SPEED = 8.0
PLAYER_ACCEL = 1.0
PLAYER_FRICTION = 0.90
PLAYER_MAX_SPEED = 12.0

BULLET_SPEED = 20.0
GHOST_SPAWN_DIST = 700
LIGHT_RANGE = 500
LIGHT_ANGLE = 30

# Ghost Types
G_NORMAL = 0
G_SLOW = 1
G_FAST = 2
G_INVISIBLE = 3
G_BOSS = 4

# Visuals
player_legs_anim = 0
anim_dir = 1
heartbeat_timer = 0.0
heartbeat_phase = 0.0
last_time = 0

#  Logic Functions
def init_game():
    global game_level, ghosts, bullets, powerups, fear_level, player_pos, score, game_over
    global player_health, player_angle, player_vel, keys_pressed, camera_pos, camera_look_at
    global leg_angle, is_moving

    game_level = 1
    ghosts = []
    bullets = []
    powerups = []
    player_pos = [0.0, 0.0, 0.0]
    player_vel = [0.0, 0.0, 0.0]
    player_angle = 0.0
    keys_pressed = set()
    leg_angle = 0.0
    is_moving = False

    # Reset smooth camera
    camera_pos = [0, 500, 500]
    camera_look_at = [0, 0, 0]

    fear_level = 0.0
    player_health = 100.0
    score = 0
    game_over = False

    start_level(game_level)

    # Enable features (background)
    glClearColor(0.8, 0.45, 0.1, 1.0)
    glEnable(GL_DEPTH_TEST)
    glEnable(GL_FOG)
    # Fog matches the golden
    glFogfv(GL_FOG_COLOR, [0.8, 0.45, 0.1, 1.0])
    glFogi(GL_FOG_MODE, GL_EXP2)
    glFogf(GL_FOG_DENSITY, 0.0015)
    glEnable(GL_BLEND)
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)

def start_level(lvl):
    global game_level
    game_level = lvl
    if lvl == 1:
        count = 1
        speed_base = 0.5
    elif lvl == 2:
        count = 2
        speed_base = 1.0
    elif lvl == 3:
        count = 3
        speed_base = 1.5
    else:
        count = 3
        speed_base = 1.5
    for _ in range(count):
        spawn_ghost_with_speed(speed_base)

def spawn_ghost_with_speed(speed_base):
    # 3D Spawning
    ang = random.uniform(0, 2*math.pi)
    dist = random.uniform(GHOST_SPAWN_DIST*0.8, GHOST_SPAWN_DIST)
    gx = player_pos[0] + math.sin(ang) * dist
    gz = player_pos[2] + math.cos(ang) * dist
    gy = random.uniform(20, 150) # Floating ghosts

    g_type = G_NORMAL
    if game_level <= 3:
        g_type = G_NORMAL  # Fixed type for levels 1-3
    else:
        rand_val = random.random()
        if game_level >= 5 and rand_val < 0.1: g_type = G_BOSS
        elif game_level >= 3 and rand_val < 0.3: g_type = G_INVISIBLE
        elif game_level >= 2 and rand_val < 0.5: g_type = G_FAST
        elif rand_val < 0.2: g_type = G_SLOW

    # Speed is now set to level base speed
    speed = speed_base

    # 5-HIT RULE (All Levels)
    hp = 5

    scale = 1.0
    alpha = 0.6
    damage = 0.5

    if g_type == G_SLOW:
        speed *= 0.6;
    elif g_type == G_FAST:
        speed *= 1.4; damage = 1.0
    elif g_type == G_INVISIBLE:
        alpha = 0.15; speed *= 1.2
    elif g_type == G_BOSS:
        scale = 3.0; speed *= 0.5; damage = 2.0; gy = 50


    if speed > 2.5: speed = 2.5

    ghosts.append({
        'pos': [gx, gy, gz],
        'speed': speed,
        'hp': hp,
        'max_hp': hp,
        'type': g_type,
        'scale': scale,
        'alpha': alpha,
        'damage': damage,
        'hover_offset': random.uniform(0, 100),
        'dying': False,
    })

def check_light_hitting_ghost(g):
    dx = g['pos'][0] - player_pos[0]
    dz = g['pos'][2] - player_pos[2]
    # Simple Distance Check first
    if abs(dx) > LIGHT_RANGE or abs(dz) > LIGHT_RANGE: return False

    dist = math.sqrt(dx*dx + dz*dz)
    if dist > LIGHT_RANGE: return False

    # Direction check
    rad = math.radians(player_angle)
    p_dx = math.sin(rad)
    p_dz = math.cos(rad)
    g_dx, g_dz = dx/dist, dz/dist

    dot = p_dx*g_dx + p_dz*g_dz
    return dot > math.cos(math.radians(LIGHT_ANGLE))

def draw_text(x, y, text, font=GLUT_BITMAP_HELVETICA_18, r=1, g=1, b=1):
    glMatrixMode(GL_PROJECTION); glPushMatrix(); glLoadIdentity()
    gluOrtho2D(0, W_WIDTH, 0, W_HEIGHT)
    glMatrixMode(GL_MODELVIEW); glPushMatrix(); glLoadIdentity()
    glColor3f(r, g, b)
    glRasterPos2f(x, y)
    for ch in text: glutBitmapCharacter(font, ord(ch))
    glPopMatrix(); glMatrixMode(GL_PROJECTION); glPopMatrix(); glMatrixMode(GL_MODELVIEW)

def draw_shapes():
    # 1. Ground
    glPushMatrix()
    glBegin(GL_QUADS)# Saddle Brown / Autumn Floor
    glVertex3f(-GRID_LENGTH, -1, -GRID_LENGTH)
    glVertex3f(-GRID_LENGTH, -1, GRID_LENGTH)
    glVertex3f(GRID_LENGTH, -1, GRID_LENGTH)
    glVertex3f(GRID_LENGTH, -1, -GRID_LENGTH)
    glEnd()

    # 2. Player
    glPushMatrix()
    glTranslatef(player_pos[0], player_pos[1], player_pos[2])
    glRotatef(player_angle - 90, 0, 1, 0)

    # Suit
    glColor3f(0.2, 0.2, 0.5)
    glPushMatrix(); glTranslatef(0, 30, 0); glScalef(2.0, 2.5, 1.2); glutSolidCube(20); glPopMatrix()
    # Head
    glColor3f(0.8, 0.7, 0.6)
    glPushMatrix(); glTranslatef(0, 60, 0); glutSolidSphere(15, 10, 10); glPopMatrix()

    # Legs
    glColor3f(0.1, 0.1, 0.3)
    # Left leg
    glPushMatrix()
    glTranslatef(-8, 10, 0)
    glRotatef(leg_angle, 1, 0, 0)
    glTranslatef(0, -15, 0)
    glScalef(0.6, 1.5, 0.6)
    glutSolidCube(15)
    glPopMatrix()
    # Right leg
    glPushMatrix()
    glTranslatef(8, 10, 0)
    glRotatef(-leg_angle, 1, 0, 0)
    glTranslatef(0, -15, 0)
    glScalef(0.6, 1.5, 0.6)
    glutSolidCube(15)
    glPopMatrix()

    # Weapon
    glColor3f(0.8, 0.8, 0.1)
    glPushMatrix()
    glTranslatef(20, 45, 10); glRotatef(-30, 1, 0, 0); glTranslatef(0, 0, 20)
    glPushMatrix(); glScalef(0.5, 0.5, 2.0); glutSolidCube(10); glPopMatrix()
    glEnable(GL_BLEND); glColor4f(1.0, 1.0, 0.8, 0.6)
    glTranslatef(0, 0, 10); glutSolidSphere(3, 8, 8); glDisable(GL_BLEND)
    glPopMatrix()

    glPopMatrix()

    # 3. Ghosts
    for g in ghosts:
        glPushMatrix()
        glTranslatef(g['pos'][0], g['pos'][1], g['pos'][2])
        s = g.get('scale', 1.0); glScalef(s, s, s)

        # Face Player
        dx = player_pos[0] - g['pos'][0]
        dz = player_pos[2] - g['pos'][2]
        ang = math.degrees(math.atan2(dx, dz))
        glRotatef(ang, 0, 1, 0)

        # Bob
        bob = math.sin(glutGet(GLUT_ELAPSED_TIME)*0.003 + g.get('hover_offset', 0))*8
        glTranslatef(0, bob, 0)

        # Color & Alpha
        alpha = g.get('alpha', 0.6)
        r, gr, b = 0.9, 0.9, 1.0

        # Color Override (Flash)
        if g.get('hit_flash', 0) > 0:
            r, gr, b = 1.0, 1.0, 1.0
            alpha = 0.9
        else:
            if g.get('type') == G_BOSS: r, gr, b = 1.0, 0.1, 0.1
            elif g.get('type') == G_FAST: r, gr, b = 1.0, 0.6, 0.0
            elif g.get('type') == G_SLOW: r, gr, b = 0.4, 0.6, 0.4

        glColor4f(r, gr, b, alpha)

        # Ghost Shape
        glPushMatrix(); glTranslatef(0, 45, 0); glutSolidSphere(10, 10, 10)
        # Eyes
        glColor3f(1, 0, 0)
        glTranslatef(4, 2, 8); glutSolidSphere(2, 5, 5)
        glTranslatef(-8, 0, 0); glutSolidSphere(2, 5, 5)
        glPopMatrix()

        glColor4f(r, gr, b, alpha)
        glPushMatrix(); glTranslatef(0, 20, 0); glRotatef(-90, 1, 0, 0)
        gluCylinder(gluNewQuadric(), 15, 5, 25, 10, 10); glPopMatrix()
        glPopMatrix()

    # 4. Bullets
    glEnable(GL_BLEND)
    for b in bullets:
        glPushMatrix(); glTranslatef(b['pos'][0], b['pos'][1], b['pos'][2])
        glColor4f(1, 1, 0.5, 0.9); glutSolidSphere(3, 8, 8)
        glColor4f(1, 1, 0.8, 0.4); glutSolidSphere(6, 8, 8)
        glPopMatrix()
    glDisable(GL_BLEND)

    # 5. Environment Objects
    glColor3f(0.35, 0.25, 0.15)
    for i in range(-700, 701, 150):
        for j in range(-700, 701, 150):
            if abs(i) < 50 and abs(j) < 50: continue
            glPushMatrix()
            glTranslatef(i + (j%100), 25, j + (i%70))
            glScalef(1, 2.5, 0.2); glutSolidCube(20)
            glPopMatrix()

    glPopMatrix()

def setupCamera():
    glMatrixMode(GL_PROJECTION); glLoadIdentity()
    gluPerspective(fovY, 1.25, 0.1, 1500)
    glMatrixMode(GL_MODELVIEW); glLoadIdentity()


    if camera_mode == 0:
        gluLookAt(camera_pos[0], camera_pos[1], camera_pos[2],
                  camera_look_at[0], camera_look_at[1], camera_look_at[2],
                  0, 1, 0)
    elif camera_mode == 1:
        rad = math.radians(player_angle)
        cam_x = player_pos[0] + math.sin(rad) * 20
        cam_z = player_pos[2] + math.cos(rad) * 20
        look_x = player_pos[0] + math.sin(rad) * 1000
        look_z = player_pos[2] + math.cos(rad) * 1000
        gluLookAt(cam_x, player_pos[1] + 60, cam_z,
                  look_x, player_pos[1] + 60, look_z,
                  0, 1, 0)
    elif camera_mode == 2:
        gluLookAt(player_pos[0], 1200, player_pos[2],
                  player_pos[0], 0, player_pos[2],
                  0, 0, -1)

def idle():
    global fear_level, game_over, score, game_level, heartbeat_timer, player_health
    global player_pos, player_vel, player_angle, camera_pos, camera_look_at, last_time
    global level_text_timer, game_win, heartbeat_phase

    # Delta Time Calculation
    curr_time = glutGet(GLUT_ELAPSED_TIME)
    if last_time == 0: last_time = curr_time
    dt = (curr_time - last_time) / 1000.0
    last_time = curr_time
    if dt > 0.1: dt = 0.1 # Cap lag

    # Level Text Timer
    if level_text_timer > 0:
        level_text_timer -= dt

    if game_over or game_win:
        glutPostRedisplay(); return


    accel = PLAYER_ACCEL * 60.0

    # Input Forces
    force_x = 0.0
    force_z = 0.0

    if GLUT_KEY_UP in keys_pressed: force_z -= accel
    if GLUT_KEY_DOWN in keys_pressed: force_z += accel
    if GLUT_KEY_LEFT in keys_pressed: force_x -= accel
    if GLUT_KEY_RIGHT in keys_pressed: force_x += accel

    # Apply to Velocity (v = u + at)
    player_vel[0] += force_x * dt
    player_vel[2] += force_z * dt

    # Friction (Exponential Decay)

    friction = math.pow(PLAYER_FRICTION, dt * 60.0)
    player_vel[0] *= friction
    player_vel[2] *= friction

    # Cap speed
    curr_speed = math.sqrt(player_vel[0]**2 + player_vel[2]**2)
    if curr_speed > PLAYER_MAX_SPEED:
        scale = PLAYER_MAX_SPEED / curr_speed
        player_vel[0] *= scale
        player_vel[2] *= scale

    # Stop completely if slow
    if curr_speed < 0.1:
        player_vel[0] = 0; player_vel[2] = 0


    move_scale = 60.0
    player_pos[0] += player_vel[0] * dt * move_scale
    player_pos[2] += player_vel[2] * dt * move_scale

    # Update Angle to face movement direction if moving
    if curr_speed > 0.5:
        target_angle = math.degrees(math.atan2(player_vel[0], player_vel[2]))
        # Smooth turn could go here, but instant snap is okay for now
        player_angle = target_angle

    # Clamp
    if player_pos[0] > GRID_LENGTH: player_pos[0] = GRID_LENGTH
    if player_pos[0] < -GRID_LENGTH: player_pos[0] = -GRID_LENGTH
    if player_pos[2] > GRID_LENGTH: player_pos[2] = GRID_LENGTH
    if player_pos[2] < -GRID_LENGTH: player_pos[2] = -GRID_LENGTH

    # Leg animation
    global is_moving, leg_angle
    is_moving = (GLUT_KEY_UP in keys_pressed or GLUT_KEY_DOWN in keys_pressed or
                 GLUT_KEY_LEFT in keys_pressed or GLUT_KEY_RIGHT in keys_pressed)
    if is_moving:
        leg_angle += 15
        if leg_angle > 45:
            leg_angle = -45

    # --- CAMERA LERP ---
    rad = math.radians(player_angle)


    target_cam_x = player_pos[0] - math.sin(rad) * 400
    target_cam_z = player_pos[2] - math.cos(rad) * 400
    target_cam_y = player_pos[1] + 350

    # Lerp factor (Smoothness)
    lerp = 0.05
    camera_pos[0] += (target_cam_x - camera_pos[0]) * lerp
    camera_pos[1] += (target_cam_y - camera_pos[1]) * lerp
    camera_pos[2] += (target_cam_z - camera_pos[2]) * lerp

    # LookAt Target (Player Head)
    camera_look_at[0] += (player_pos[0] - camera_look_at[0]) * 0.1
    camera_look_at[1] += ((player_pos[1]+50) - camera_look_at[1]) * 0.1
    camera_look_at[2] += (player_pos[2] - camera_look_at[2]) * 0.1

    # --- GAME LOGIC ---
    active_ghosts = []

    alive_count = 0
    min_dist = 9999

    for g in ghosts:
        # Handle Dying State
        if g.get('dying', False):
            # Death Animation: Fade out
            g['alpha'] -= 2.0 * dt
            g['pos'][1] += 50 * dt
            if g['alpha'] > 0:
                active_ghosts.append(g)
            else:

                score += 10
                if random.random() < 0.2:
                    powerups.append({'pos': list(g['pos']), 'type': random.choice([0, 1])})
            continue

        alive_count += 1

        # Approach Player
        dx = player_pos[0] - g['pos'][0]
        dz = player_pos[2] - g['pos'][2]
        dist = math.sqrt(dx*dx + dz*dz)
        if dist < min_dist: min_dist = dist

        # Ghost Speed Calculation (dt based)
        base_speed = 40.0
        move_dist = base_speed * g['speed'] * dt

        if dist > 30:
            g['pos'][0] += (dx/dist) * move_dist
            g['pos'][2] += (dz/dist) * move_dist

        # Collision (Continuous Logic)
        if dist < 45:
            # Continuous Damage
            dps = 15.0 * g.get('damage', 1.0)
            player_health -= dps * dt

            # Fear Increase (Faster when touching)
            fear_level += 20.0 * dt

            # Knockback forces
            kb_force = 150.0 * dt
            if dist > 0.1:
                player_vel[0] += (dx/dist) * kb_force
                player_vel[2] += (dz/dist) * kb_force

        # Fear (Proximity)
        if dist < 500:
            idx_factor = (500-dist)/500.0
            fear_level += 5.0 * idx_factor * dt

        # Flash Timer
        if g.get('hit_flash', 0) > 0:
            g['hit_flash'] -= dt

        active_ghosts.append(g)

    # Heartbeat Logic

    hb_speed = 0.0
    if min_dist < 600:

        factor = (600 - min_dist) / 600.0
        hb_speed = 2.0 + (factor * 8.0)
    heartbeat_phase += hb_speed * dt

    # Check Wave Completion
    if alive_count == 0 and len(ghosts) > 0:
        pass

    if len(active_ghosts) == 0:
        if game_level < 3:
            start_level(game_level + 1)
        else:
            game_win = True
    else:
        ghosts[:] = active_ghosts

    # Bullets
    active_bullets = []
    for b in bullets:
        b['pos'][0] += b['dir'][0]
        b['pos'][2] += b['dir'][1]
        hit = False
        if abs(b['pos'][0]) > GRID_LENGTH or abs(b['pos'][2]) > GRID_LENGTH: hit = True

        for g in ghosts:
            if g.get('dying', False): continue

            dist = math.sqrt((b['pos'][0]-g['pos'][0])**2 + (b['pos'][2]-g['pos'][2])**2)
            # Simple Sphere Collision
            if dist < 30 * g.get('scale', 1.0):
                # INSTANT KILL
                g['hp'] = 0
                g['hit_flash'] = 0.2 # Flash White for 0.2s

                if g['hp'] <= 0:
                    g['dying'] = True

                hit = True; break

        if not hit: active_bullets.append(b)
    bullets[:] = active_bullets

    # Powerups
    active_powerups = []
    for p in powerups:
        p['angle'] = (p.get('angle', 0) + 2) % 360
        dx = player_pos[0] - p['pos'][0]; dz = player_pos[2] - p['pos'][2]
        if math.sqrt(dx*dx + dz*dz) < 40:
            if p['type'] == 0: player_health = min(100, player_health + 30)
            elif p['type'] == 1: fear_level = max(0, fear_level - 40)
        else: active_powerups.append(p)
    powerups[:] = active_powerups

    # Rules
    if fear_level >= max_fear: game_over = True
    if player_health <= 0: game_over = True
    if fear_level > 0: fear_level -= 0.02

    glutPostRedisplay()

def showScreen():
    global level_text_timer, game_win, heartbeat_phase

    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
    glLoadIdentity()

    setupCamera()
    draw_shapes()

    # Draw Powerups specifically
    for p in powerups:
        glPushMatrix()
        glTranslatef(p['pos'][0], 30, p['pos'][2])
        glRotatef(p.get('angle', 0), 0, 1, 0)
        if p['type'] == 0: glColor3f(0, 1, 0) # Green Health
        else: glColor3f(0, 1, 1) # Cyan Fear Reduce
        glutSolidSphere(10, 8, 8)
        glPopMatrix()

    # UI Override
    glDisable(GL_DEPTH_TEST) # Ensure UI on top

    # 1. Level Text Overlay
    if level_text_timer > 0:
        glMatrixMode(GL_PROJECTION); glPushMatrix(); glLoadIdentity()
        gluOrtho2D(0, W_WIDTH, 0, W_HEIGHT)
        glMatrixMode(GL_MODELVIEW); glPushMatrix(); glLoadIdentity()

        alpha = 1.0
        if level_text_timer < 0.5: alpha = level_text_timer * 2.0

        # Center Text
        txt = f"LEVEL {game_level}"
        if game_level == 3: txt += " - FINAL WAVE"

        glColor4f(1, 0.8, 0, alpha)
        # Scale for Big Text
        glScalef(2, 2, 1)
        draw_text(W_WIDTH//4, W_HEIGHT//4, txt, r=1, g=0.8, b=0)

        glPopMatrix(); glMatrixMode(GL_PROJECTION); glPopMatrix(); glMatrixMode(GL_MODELVIEW)


    # Health Bar
    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    gluOrtho2D(0, W_WIDTH, 0, W_HEIGHT)
    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()

    # Health Base
    glColor3f(0.3, 0.3, 0.3)
    glBegin(GL_QUADS)
    glVertex2f(20, W_HEIGHT-40); glVertex2f(220, W_HEIGHT-40)
    glVertex2f(220, W_HEIGHT-20); glVertex2f(20, W_HEIGHT-20)
    glEnd()

    # Health Fill
    glColor3f(0.8, 0, 0)
    w = 200 * (max(0, player_health)/100.0)
    glBegin(GL_QUADS)
    glVertex2f(20, W_HEIGHT-40); glVertex2f(20+w, W_HEIGHT-40)
    glVertex2f(20+w, W_HEIGHT-20); glVertex2f(20, W_HEIGHT-20)
    glEnd()

    draw_text(230, W_HEIGHT-35, f"HP: {int(player_health)}")

    # Info
    info = f"Score: {score} | Level: {game_level} | Ghosts: {len(ghosts)}"
    draw_text(20, W_HEIGHT-70, info)

    fear_str = f"FEAR: {int(fear_level)}%"
    # Color logic for fear text
    fr, fg, fb = 1, 1, 1
    if fear_level > 50: fr, fg, fb = 1, 1, 0
    if fear_level > 80: fr, fg, fb = 1, 0, 0
    draw_text(20, W_HEIGHT-90, fear_str, r=fr, g=fg, b=fb)


    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)

    if game_over:
        draw_text(W_WIDTH//2-100, W_HEIGHT//2, "GAME OVER! Press R", r=1, g=0, b=0)

    # Darken and Redden screen based on Fear and Low Health
    damage_factor = (100.0 - player_health) / 100.0
    if damage_factor < 0: damage_factor = 0

    # Combined intensity
    overlay_alpha = 0.0
    if fear_level > 20: overlay_alpha += (fear_level-20)/120.0
    if damage_factor > 0.0: overlay_alpha += damage_factor * 0.4 # Pain vignette


    # Force Heartbeat Visibility if Pulse is fast

    pulse_val = (math.sin(heartbeat_phase) + 1.0) * 0.5 # 0 to 1


    if pulse_val > 0.1:

         pass


    overlay_alpha += 0.3 * pulse_val * (1.0 if fear_level > 0 or damage_factor > 0 else 0.5)

    if overlay_alpha > 0.9: overlay_alpha = 0.9

    if overlay_alpha > 0.05:
        glMatrixMode(GL_PROJECTION); glPushMatrix(); glLoadIdentity()
        gluOrtho2D(0, W_WIDTH, 0, W_HEIGHT)
        glMatrixMode(GL_MODELVIEW); glPushMatrix(); glLoadIdentity()
        glEnable(GL_BLEND)

        r_val = 0.3 + (0.7 * pulse_val) # Red pulses

        glColor4f(r_val, 0, 0, overlay_alpha)
        glBegin(GL_QUADS)
        glVertex2f(0,0); glVertex2f(W_WIDTH,0); glVertex2f(W_WIDTH,W_HEIGHT); glVertex2f(0,W_HEIGHT)
        glEnd()
        glPopMatrix()
        glMatrixMode(GL_PROJECTION)
        glPopMatrix()
        glMatrixMode(GL_MODELVIEW)

    glEnable(GL_DEPTH_TEST)
    glutSwapBuffers()



def keyboardListener(key, x, y):
    global camera_mode, player_angle

    # Case insensitive checks
    if key == b'r' or key == b'R':
        init_game()

    if key == b'k' or key == b'K':
        # Shoot Logic (Hand Light)

        rad = math.radians(player_angle)

        # Forward Vector
        fwd_x = math.sin(rad)
        fwd_z = math.cos(rad)

        # Right Vector (Perpendicular)

        right_x = math.cos(rad)
        right_z = -math.sin(rad)

        # Spawn Offset: Move Forward a bit, then Right a bit
        spawn_x = player_pos[0] + (fwd_x * 15) + (right_x * 12)
        spawn_z = player_pos[2] + (fwd_z * 15) + (right_z * 12)

        bullets.append({
            'pos': [spawn_x, player_pos[1] + 35, spawn_z], # Hand Height ~35
            'dir': [fwd_x * BULLET_SPEED, fwd_z * BULLET_SPEED]
        })

    if key == b'c' or key == b'C':
        # Cheat
        for i in range(8):
            angle = i * 45
            rad = math.radians(angle + player_angle)
            dx = math.sin(rad) * BULLET_SPEED
            dz = math.cos(rad) * BULLET_SPEED
            bullets.append({
                'pos': [player_pos[0], 40, player_pos[2]],
                'dir': [dx, dz]
            })

    if key == b'd' or key == b'D':
        camera_mode = (camera_mode + 1) % 3

def specialKeyDown(key, x, y):
    keys_pressed.add(key)

def specialKeyUp(key, x, y):
    if key in keys_pressed:
        keys_pressed.remove(key)

def mouseListener(button, state, x, y):
    pass

